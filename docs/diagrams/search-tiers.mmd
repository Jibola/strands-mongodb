flowchart LR
  query(["store.search(query)"])
  hybrid_ok{"Hybrid ready?<br/>MongoDB 8.0+, both indexes, no score bound"}
  vector_ok{"Vector index ready?"}
  text_ok{"Text index ready?"}
  hybrid["hybrid<br/>$rankFusion of vector and text"]
  vector["vector<br/>$vectorSearch"]
  text["text<br/>$search"]
  error["StorageError<br/>No tier can answer"]
  query --> hybrid_ok
  hybrid_ok -->|yes| hybrid
  hybrid_ok -->|no| vector_ok
  vector_ok -->|yes| vector
  vector_ok -->|no| text_ok
  text_ok -->|yes| text
  text_ok -->|no| error
